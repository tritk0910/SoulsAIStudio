<Project Sdk="Microsoft.NET.Sdk">
  <!-- Souls AI Studio perf baseline bench (read-only against game/mod/test data). Not part of the .sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Machine may only have the .NET 10 runtime. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SoulsAiStudio.Bench</RootNamespace>
    <!-- SoulsFormats Release build targets x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SoulsAssetPipeline\SoulsFormats\SoulsFormats.csproj" />
  </ItemGroup>
</Project>
